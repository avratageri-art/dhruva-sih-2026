# Docker Compose database settings (local development values only)
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=aegis
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_me_local_only

# Backend runtime. For non-Docker local development, SQLite works without services.
PROJECT_NAME=DHRUVA
DATABASE_URL=sqlite:///./darktrace.db
NEO4J_URI=bolt://localhost:7687
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
MODEL_PATH=./models/baseline
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
API_URL=http://localhost:8000

# Tor SOCKS proxy. Tor is optional for the controlled demo workflow.
TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9050

# Optional Robin search engines as a JSON array of {"name","url"} objects.
# Leave empty for the synthetic SIH demo. Configure only authorized research
# sources; each URL must be HTTP(S), end in .onion, and contain {query}.
ROBIN_SEARCH_ENGINES_JSON=[]

# DeepDarkCTI collection controls
DEEPDARKCTI_REFRESH_INTERVAL=3600
DEEPDARKCTI_COLLECT_INTERVAL=300
DEEPDARKCTI_MAX_SOURCES_PER_CYCLE=5
DEEPDARKCTI_COLLECT_TIMEOUT=20

# Public browser-side URL; never place a private key in a VITE_* variable.
VITE_API_URL=http://localhost:8000
